rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    // 연구자와 관리자는 환자·기록을 볼 수 있음
    function isResearcher() { return signedIn() && (role() == 'researcher' || role() == 'admin'); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isResearcher());
      allow create: if signedIn() && request.auth.uid == uid;
      // 본인은 역할 변경 불가, 관리자는 모든 계정 수정 가능
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.get('disabled', false) == resource.data.get('disabled', false));
      allow list: if isAdmin();
    }

    match /patients/{studyId} {
      allow list: if isResearcher();
      allow get: if signedIn() && (isResearcher()
                    || resource.data.get('uid', null) == null
                    || resource.data.uid == request.auth.uid);
      allow create, delete: if isResearcher();
      allow update: if isResearcher()
        // 환자가 연구번호를 연결(claim)
        || (signedIn() && resource.data.get('uid', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','linkedAt'])
            && request.resource.data.uid == request.auth.uid)
        // 환자가 연결 해제(그만두기)
        || (signedIn() && resource.data.get('uid', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','linkedAt'])
            && request.resource.data.uid == null);
    }

    match /sessions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isResearcher());
    }

    match /messages/{id} {
      // 환자: 본인 문의 작성·조회 / 연구자·관리자: 전체 조회, 확인·답변 처리
      // 환자는 본인 문의 작성, 연구자·관리자는 환자에게 메시지 작성 가능
      allow create: if signedIn() && (request.resource.data.uid == request.auth.uid || isResearcher());
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isResearcher());
      // 환자는 읽음 표시(pRead, replyRead)만 수정 가능
      allow update: if isResearcher() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pRead','replyRead']));
    }
  }
}